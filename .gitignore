# Dependencies
node_modules/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Test / coverage
coverage/
.nyc_output/

# Playwright / visual-test artifacts (regenerated in CI, deployed to Pages)
visual-artifacts/
test-results/
playwright-report/
.playwright/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code — personal, per-user settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Spec Kit — additional ignore rules are added by `specify init` at P0.

# Written by the retrospective skill; checked by the pre-PR hook (.claude/hooks/require-retro-before-pr.sh)
.claude/.retro-done

# Written at SessionStart by .claude/hooks/record-designated-branch.sh; read by
# .claude/hooks/guard-designated-branch.sh. Per-session, never shared.
.claude/.session-branch

# Single-use commit/push approval token, written only after the owner says go in words;
# read and consumed by .claude/hooks/guard-git-write.sh. Never shared, never committed.
.claude/.git-go

# Midjourney 2x2 grids are SOURCE, not shipped assets — kept on the owner's drive or a
# GitHub Release, never committed (scripts/check-assets.mjs enforces the size cap; this
# just stops `git add -A` re-adding one). Commit the chosen crop + its prompt instead.
docs/visual/portraits/reference/*-4.png
docs/visual/portraits/reference/*-4-*.png
