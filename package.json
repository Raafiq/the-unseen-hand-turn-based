{
  "name": "the-unseen-hand-turn-based",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Systems/combat game for a turn-based tactics RPG (FFT:WotL-inspired). Pure headless TS sim + thin render layer.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:rng": "bash .claude/skills/sim-determinism-guard/scripts/check-rng.sh src/sim && bash .claude/skills/sim-determinism-guard/scripts/check-rng.sh src/render/playtest.ts",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=coverage/vitest-summary.json",
    "test:watch": "vitest",
    "state": "vite-node scripts/gen-state.mts",
    "test:visual": "npm run build && playwright test",
    "gallery": "node scripts/build-gallery.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:rng && npm run check:handoff && npm run check:story && npm run test && npm run check:counts && npm run check:assets",
    "check:handoff": "bash scripts/check-handoff.sh",
    "check:story": "bash scripts/check-story-literals.sh",
    "check:counts": "node scripts/check-counts.mjs",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^3.24.0"
  }
}
