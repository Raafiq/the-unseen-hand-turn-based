{
  "name": "the-unseen-hand-turn-based",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Systems/combat game for a turn-based tactics RPG (FFT:WotL-inspired). Pure headless TS sim + thin render layer.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:rng": "bash .claude/skills/sim-determinism-guard/scripts/check-rng.sh src/sim",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run check:rng && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^3.24.0"
  }
}
